local OBSIDIAN_URL = "https://raw.githubusercontent.com/deividcomsono/Obsidian/refs/heads/main/Library.lua"
local THEME_URL = "https://raw.githubusercontent.com/deividcomsono/Obsidian/refs/heads/main/addons/ThemeManager.lua"
local SAVE_URL = "https://raw.githubusercontent.com/deividcomsono/Obsidian/refs/heads/main/addons/SaveManager.lua"
local XUAN_ICON_ASSET = 108980322155893

local Players = game:GetService("Players")
local player = Players.LocalPlayer or Players.PlayerAdded:Wait()

local function loadModifiedLibrary()
    local playerGui = player:WaitForChild("PlayerGui")
    local source = game:HttpGet(OBSIDIAN_URL)

    source = source:gsub(
        'gethui%s*%([^%)]*%)',
        'game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui")'
    )
    source = source:gsub(
        'gethui%s*%b()',
        'game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui")'
    )
    source = source:gsub(
        'local%s+gethui%s*=%s*gethui%s+or%s+function%s*%(%s*%)%s*return%s+CoreGui%s*end',
        'local gethui = gethui or function() return game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui") end'
    )

    local oldGetHui = gethui
    local oldProtectGui = protectgui
    local oldSynProtectGui = syn and syn.protect_gui

    if getgenv then
        getgenv().gethui = function()
            return player:WaitForChild("PlayerGui")
        end
        getgenv().protectgui = function() end
        if syn then
            syn.protect_gui = function() end
        end
    end

    -- Patch default accent colors from Violet (7c5cff / 125,85,255) to Soft Girl Pink (#ff70a6 / 255,112,166)
    source = source:gsub('Color3%.fromRGB%(125,%s*85,%s*255%)', 'Color3.fromRGB(255, 112, 166)')
    source = source:gsub('7c5cff', 'ff70a6')
    source = source:gsub('7d55ff', 'ff70a6')

    -- Disable default Lock button on Mobile in Obsidian source
    source = source:gsub('local LockButton = Library:AddDraggableButton%("Lock".-end, true, true%)', '')
    source = source:gsub('LockButton%.Button%.AnchorPoint = [^\n]+', '')
    source = source:gsub('LockButton%.Button%.Position = [^\n]+', '')
    source = source:gsub('LockButton%.Button%.Visible = false', '')
    source = source:gsub('LockButton%.Button%.Visible = [^\n]+', '')

    local libraryFunc = assert(loadstring(source), "XUAN Obsidian loadstring failed")
    local Library = libraryFunc()

    if Library and Library.Scheme then
        Library.Scheme.AccentColor = Color3.fromHex("ff70a6")
        Library.Scheme.MainColor = Color3.fromHex("181517")
        Library.Scheme.BackgroundColor = Color3.fromHex("0f0d0e")
        Library.Scheme.OutlineColor = Color3.fromHex("30242a")
        Library.Scheme.FontColor = Color3.fromHex("ffffff")
    end

    if getgenv then
        getgenv().gethui = oldGetHui
        getgenv().protectgui = oldProtectGui
        if syn then
            syn.protect_gui = oldSynProtectGui
        end
    end

    if Library.ScreenGui and Library.ScreenGui.Parent ~= playerGui then
        Library.ScreenGui.Parent = playerGui
    end
    return Library
end

local function addRegistry(Library, instance, properties)
    if type(Library.AddToRegistry) == "function" then
        Library:AddToRegistry(instance, properties)
    end
end

-- Default fallback tab descriptions across games
local DEFAULT_TAB_DESCRIPTIONS = {
    Home = "Home dashboard",
    Main = "Main features",
    Steal = "Egg stealing and flight engine",
    Automation = "Auto hatch, place, and sell eggs",
    Webhooks = "Discord telemetry and alerts",
    Planting = "Planting features",
    ["Moon Prediction"] = "Moon prediction tools",
    Method = "Method features",
    ["Paid Features"] = "Paid features",
    Shop = "Shop features",
    ESP = "ESP and visual highlights",
    Settings = "Settings and config utilities",
}

local function applyXuanWindowStyle(Library, Window, windowInfo)
    windowInfo = windowInfo or {}
    local header = {}

    -- Merge custom tab descriptions passed via CreateWindow with fallback defaults
    local customTabDescriptions = {}
    for k, v in pairs(DEFAULT_TAB_DESCRIPTIONS) do
        customTabDescriptions[k] = v
    end
    if type(windowInfo.TabDescriptions) == "table" then
        for k, v in pairs(windowInfo.TabDescriptions) do
            customTabDescriptions[k] = v
        end
    elseif type(windowInfo.Subtitles) == "table" then
        for k, v in pairs(windowInfo.Subtitles) do
            customTabDescriptions[k] = v
        end
    end

    local headerTitleWidth = tonumber(windowInfo.HeaderTitleWidth) or 0.36
    local headerRightWidth = tonumber(windowInfo.HeaderRightWidth) or 0.53
    local circleMode = (windowInfo.CircleLogo ~= false and (windowInfo.Wordmark == nil and windowInfo.ToggleText == nil))
    local toggleText = tostring(windowInfo.ToggleText or windowInfo.Wordmark or "XUAN4SHO")
    local toggleIconAsset = windowInfo.ToggleIcon or windowInfo.Icon or XUAN_ICON_ASSET
    local toggleSize = windowInfo.ToggleSize or (circleMode and UDim2.fromOffset(46, 46) or UDim2.fromOffset(142, 40))
    local togglePos = windowInfo.TogglePosition or UDim2.fromOffset(10, 60)
    local showCloseBtn = (windowInfo.ShowCloseButton == true or windowInfo.CloseButton == true)
    local closeBtnText = tostring(windowInfo.CloseButtonText or "X Close")
    local closeBtnPos = windowInfo.CloseButtonPosition or (circleMode and UDim2.fromOffset(62, 60) or UDim2.fromOffset(164, 60))
    local closeDialogTitle = tostring(windowInfo.CloseDialogTitle or "Exit Script?")
    local closeDialogDesc = tostring(windowInfo.CloseDialogDesc or "Are you sure you want to exit?")

    local function tabDescription(name)
        name = tostring(name or "Main")
        return customTabDescriptions[name] or (name .. " features")
    end

    local function findWindowHeader()
        if header.TopBar and header.TopBar.Parent then
            return true
        end

        local screenGui = Library.ScreenGui
        local mainFrame = screenGui and screenGui:FindFirstChild("Main", true)
        if not mainFrame then
            return false
        end

        local divider
        for _, child in ipairs(mainFrame:GetChildren()) do
            if child:IsA("Frame")
                and child.Size.X.Scale == 0 and child.Size.X.Offset == 1
                and child.Size.Y.Scale == 1 and child.Size.Y.Offset == -21 then
                divider = child
                break
            end
        end

        local topBar
        for _, child in ipairs(mainFrame:GetChildren()) do
            if child:IsA("Frame")
                and child.Size.X.Scale == 1 and child.Size.X.Offset == 0
                and child.Size.Y.Scale == 0 and child.Size.Y.Offset == 48
                and child.Position.X.Scale == 0 and child.Position.X.Offset == 0
                and child.Position.Y.Scale == 0 and child.Position.Y.Offset == 0 then
                topBar = child
                break
            end
        end
        if not topBar then
            return false
        end
        topBar.Name = "XuanWindowTopBar"

        local titleHolder
        for _, child in ipairs(topBar:GetChildren()) do
            if child:IsA("Frame")
                and child.Size.X.Scale == 0
                and child.Size.Y.Scale == 1
                and child:FindFirstChildOfClass("UIListLayout") then
                titleHolder = child
                break
            end
        end
        if not titleHolder then
            return false
        end
        titleHolder.Name = "XuanWindowTitleHolder"

        local title
        for _, child in ipairs(titleHolder:GetChildren()) do
            if child:IsA("TextLabel") then
                title = child
                break
            end
        end
        if not title then
            return false
        end

        local titleLayout = titleHolder:FindFirstChildOfClass("UIListLayout")
        if titleLayout then
            titleLayout.FillDirection = Enum.FillDirection.Vertical
            titleLayout.HorizontalAlignment = Enum.HorizontalAlignment.Left
            titleLayout.VerticalAlignment = Enum.VerticalAlignment.Center
            titleLayout.Padding = UDim.new(0, 0)
        end

        local titlePadding = titleHolder:FindFirstChild("XuanWindowTitlePadding")
        if not titlePadding then
            titlePadding = Instance.new("UIPadding")
            titlePadding.Name = "XuanWindowTitlePadding"
            titlePadding.PaddingLeft = UDim.new(0, 14)
            titlePadding.PaddingRight = UDim.new(0, 8)
            titlePadding.Parent = titleHolder
        end

        for _, child in ipairs(titleHolder:GetChildren()) do
            if child:IsA("ImageLabel") then
                child.Visible = false
                child.Size = UDim2.fromOffset(0, 0)
            end
        end

        title.Visible = true
        title.LayoutOrder = 1
        title.Size = UDim2.new(1, -22, 0, 22)
        title.TextXAlignment = Enum.TextXAlignment.Left
        title.TextYAlignment = Enum.TextYAlignment.Bottom
        title.TextSize = 20
        title.TextTransparency = 0

        local subtitle = titleHolder:FindFirstChild("XuanWindowSubtitle")
        if not subtitle then
            subtitle = Instance.new("TextLabel")
            subtitle.Name = "XuanWindowSubtitle"
            subtitle.BackgroundTransparency = 1
            subtitle.BorderSizePixel = 0
            subtitle.Parent = titleHolder
        end
        subtitle.LayoutOrder = 2
        subtitle.Size = UDim2.new(1, -22, 0, 17)
        subtitle.FontFace = Library.Scheme.Font
        subtitle.TextColor3 = Library.Scheme.FontColor
        subtitle.TextSize = 14
        subtitle.TextTransparency = 0.35
        subtitle.TextXAlignment = Enum.TextXAlignment.Left
        subtitle.TextYAlignment = Enum.TextYAlignment.Top
        subtitle.Text = windowInfo.Subtitle or windowInfo.DefaultSubtitle or tabDescription("Main")
        addRegistry(Library, subtitle, { TextColor3 = "FontColor", FontFace = "Font" })

        local search = topBar:FindFirstChildWhichIsA("TextBox", true)
        local rightWrapper
        if search then
            search.Name = "XuanWindowSearch"
            search.PlaceholderText = "Search..."
            search.BackgroundTransparency = 0.12
            search.Size = UDim2.new(1, -20, 1, 0)
            local searchCorner = search:FindFirstChildOfClass("UICorner")
            if searchCorner then
                searchCorner.CornerRadius = UDim.new(1, 0)
            end
            local searchStroke = search:FindFirstChildOfClass("UIStroke")
            if searchStroke then
                searchStroke.Thickness = 1
                searchStroke.Transparency = 0.2
            end

            rightWrapper = search.Parent
            if rightWrapper and rightWrapper:IsA("Frame") then
                rightWrapper.Name = "XuanWindowRightWrapper"
                rightWrapper.AnchorPoint = Vector2.new(1, 0.5)
                rightWrapper.Position = UDim2.new(1, -78, 0.5, 0)
                rightWrapper.Size = UDim2.new(0, 190, 1, -14)
                local rightPadding = rightWrapper:FindFirstChild("XuanWindowRightPadding")
                if not rightPadding then
                    rightPadding = Instance.new("UIPadding")
                    rightPadding.Name = "XuanWindowRightPadding"
                    rightPadding.PaddingRight = UDim.new(0, 4)
                    rightPadding.Parent = rightWrapper
                end
            end
        end

        local dragIcon = nil
        for _, child in ipairs(topBar:GetChildren()) do
            if child:IsA("ImageLabel") and child.AnchorPoint.X == 1 then
                dragIcon = child
                dragIcon.AnchorPoint = Vector2.new(1, 0.5)
                dragIcon.Position = UDim2.new(1, -10, 0.5, 0)
                dragIcon.Size = UDim2.fromOffset(20, 20)
                dragIcon.ImageTransparency = 0.25
                break
            end
        end

        local minimize = topBar:FindFirstChild("XuanWindowMinimize")
        if not minimize then
            minimize = Instance.new("ImageButton")
            minimize.Name = "XuanWindowMinimize"
            minimize.AnchorPoint = Vector2.new(1, 0.5)
            minimize.BackgroundTransparency = 1
            minimize.BorderSizePixel = 0
            minimize.Position = UDim2.new(1, -42, 0.5, 0)
            minimize.Size = UDim2.fromOffset(24, 24)
            minimize.AutoButtonColor = false
            minimize.ZIndex = 25
            minimize.Parent = topBar

            local minusIcon = type(Library.GetIcon) == "function" and Library:GetIcon("minus") or nil
            if minusIcon then
                minimize.Image = minusIcon.Url
                minimize.ImageRectOffset = minusIcon.ImageRectOffset
                minimize.ImageRectSize = minusIcon.ImageRectSize
                minimize.ImageColor3 = Color3.fromHex("ff70a6")
                minimize.ImageTransparency = 0
            else
                local minusText = Instance.new("TextLabel")
                minusText.Name = "FallbackIcon"
                minusText.BackgroundTransparency = 1
                minusText.Size = UDim2.fromScale(1, 1)
                minusText.FontFace = Library.Scheme.Font
                minusText.Text = "—"
                minusText.TextColor3 = Color3.fromHex("ff70a6")
                minusText.TextSize = 20
                minusText.ZIndex = 26
                minusText.Parent = minimize
            end

            minimize.MouseEnter:Connect(function()
                minimize.ImageColor3 = Color3.fromRGB(255, 180, 210)
                local fb = minimize:FindFirstChild("FallbackIcon")
                if fb then fb.TextColor3 = Color3.fromRGB(255, 180, 210) end
            end)
            minimize.MouseLeave:Connect(function()
                minimize.ImageColor3 = Color3.fromHex("ff70a6")
                local fb = minimize:FindFirstChild("FallbackIcon")
                if fb then fb.TextColor3 = Color3.fromHex("ff70a6") end
            end)

            local minimizeConnection = minimize.MouseButton1Click:Connect(function()
                Library:Toggle()
            end)
            if type(Library.GiveSignal) == "function" then
                Library:GiveSignal(minimizeConnection)
            end
        else
            minimize.Position = UDim2.new(1, -42, 0.5, 0)
            minimize.Size = UDim2.fromOffset(24, 24)
            minimize.ZIndex = 25
            minimize.Visible = true
        end

        for _, child in ipairs(topBar:GetChildren()) do
            if child:IsA("ImageLabel")
                and child.AnchorPoint.X == 1
                and child.Position.X.Scale == 1 then
                child.ImageTransparency = 0.35
            end
        end

        header.MainFrame = mainFrame
        header.TopBar = topBar
        header.TitleHolder = titleHolder
        header.RightWrapper = rightWrapper
        header.Divider = divider
        header.Title = title
        header.Subtitle = subtitle
        header.Search = search
        header.Minimize = minimize

        titleHolder.Size = UDim2.new(headerTitleWidth, 0, 1, 0)
        title.Visible = true
        if rightWrapper and rightWrapper:IsA("Frame") then
            rightWrapper.Size = UDim2.new(headerRightWidth, 0, 1, -16)
        end
        if divider then
            local sidebarWidth = Window:GetSidebarWidth()
            divider.Position = UDim2.fromOffset(sidebarWidth, 48)
            divider.Size = UDim2.new(0, 1, 1, -69)
        end
        return true
    end

    local function updateWindowHeader(name, description)
        if not findWindowHeader() then
            return
        end
        header.Title.Text = tostring(name or "Main")
        header.Subtitle.Text = tostring(description or tabDescription(name))
    end

    findWindowHeader()
    updateWindowHeader("Main", windowInfo.Subtitle or windowInfo.DefaultSubtitle or tabDescription("Main"))

    local nativeSetSidebarWidth = Window.SetSidebarWidth
    Window.SetSidebarWidth = function(self, width)
        local result = nativeSetSidebarWidth(self, width)
        if header.TitleHolder and header.TitleHolder.Parent then
            header.TitleHolder.Size = UDim2.new(headerTitleWidth, 0, 1, 0)
            header.Title.Visible = true
        end
        if header.RightWrapper and header.RightWrapper.Parent then
            header.RightWrapper.Size = UDim2.new(headerRightWidth, 0, 1, -16)
        end
        if header.Divider and header.Divider.Parent then
            header.Divider.Position = UDim2.fromOffset(width, 48)
            header.Divider.Size = UDim2.new(0, 1, 1, -69)
        end
        return result
    end

    Window.ShowTabInfo = function(_, name, description)
        updateWindowHeader(name, description)
    end
    Window.HideTabInfo = function() end

    -- Runtime customization helper methods for Window
    Window.SetTabDescription = function(_, tabName, description)
        customTabDescriptions[tostring(tabName)] = tostring(description)
    end

    Window.SetTabDescriptions = function(_, descriptionsTable)
        if type(descriptionsTable) == "table" then
            for k, v in pairs(descriptionsTable) do
                customTabDescriptions[tostring(k)] = tostring(v)
            end
        end
    end

    Window.SetSubtitle = function(_, text)
        if header.Subtitle and header.Subtitle.Parent then
            header.Subtitle.Text = tostring(text or "")
        end
    end

    local floatingToggleBtn = nil
    local floatingCloseBtn = nil

    local function styleToggleButton(button)
        button.Text = ""
        button.Size = toggleSize

        local corner = button:FindFirstChildOfClass("UICorner")
        if not corner then
            corner = Instance.new("UICorner")
            corner.Parent = button
        end
        corner.CornerRadius = circleMode and UDim.new(1, 0) or UDim.new(0, 8)

        local stroke = button:FindFirstChildOfClass("UIStroke")
        if not stroke then
            stroke = Instance.new("UIStroke")
            stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
            stroke.Thickness = 1.2
            stroke.Transparency = 0.25
            stroke.Parent = button
            addRegistry(Library, stroke, { Color = "OutlineColor" })
        end

        local icon = button:FindFirstChild("Xuan4ShoIcon")
        if not icon then
            icon = button:FindFirstChildWhichIsA("ImageLabel")
            if icon then
                icon.Name = "Xuan4ShoIcon"
            end
        end
        if not icon then
            icon = Instance.new("ImageLabel")
            icon.Name = "Xuan4ShoIcon"
            icon.BackgroundTransparency = 1
            icon.Parent = button
        end

        local customIcon = Library:GetCustomIcon(toggleIconAsset)
        icon.Image = customIcon.Url
        icon.ImageRectOffset = customIcon.ImageRectOffset
        icon.ImageRectSize = customIcon.ImageRectSize
        icon.ImageColor3 = Library.Scheme.FontColor
        icon.ZIndex = 11
        addRegistry(Library, icon, { ImageColor3 = "FontColor" })

        local wordmark = button:FindFirstChild("Xuan4ShoWordmark")
        if circleMode then
            icon.AnchorPoint = Vector2.new(0.5, 0.5)
            icon.Position = UDim2.fromScale(0.5, 0.5)
            icon.Size = UDim2.fromOffset(36, 36)
            if wordmark then
                wordmark.Visible = false
            end
        else
            if not wordmark then
                wordmark = Instance.new("TextLabel")
                wordmark.Name = "Xuan4ShoWordmark"
                wordmark.BackgroundTransparency = 1
                wordmark.BorderSizePixel = 0
                wordmark.Parent = button
                addRegistry(Library, wordmark, {
                    TextColor3 = "FontColor",
                    FontFace = "Font",
                })
            end
            icon.AnchorPoint = Vector2.new(0, 0.5)
            icon.Position = UDim2.new(0, 10, 0.5, 0)
            icon.Size = UDim2.fromOffset(24, 24)

            wordmark.Visible = true
            wordmark.AnchorPoint = Vector2.new(0, 0.5)
            wordmark.Position = UDim2.new(0, 42, 0.5, 0)
            wordmark.Size = UDim2.new(1, -48, 0, 24)
            wordmark.FontFace = Library.Scheme.Font
            wordmark.Text = toggleText
            wordmark.TextColor3 = Library.Scheme.FontColor
            wordmark.TextSize = 18
            wordmark.TextXAlignment = Enum.TextXAlignment.Left
            wordmark.TextYAlignment = Enum.TextYAlignment.Center
            wordmark.ZIndex = 11
        end
    end

    Window.SetToggleText = function(_, text)
        toggleText = tostring(text or "XUAN4SHO")
        if floatingToggleBtn and floatingToggleBtn.Button then
            local wm = floatingToggleBtn.Button:FindFirstChild("Xuan4ShoWordmark")
            if wm then wm.Text = toggleText end
        end
    end

    Window.SetToggleIcon = function(_, assetId)
        toggleIconAsset = assetId or XUAN_ICON_ASSET
        if floatingToggleBtn and floatingToggleBtn.Button then
            local ic = floatingToggleBtn.Button:FindFirstChild("Xuan4ShoIcon")
            if ic then
                local customIcon = Library:GetCustomIcon(toggleIconAsset)
                ic.Image = customIcon.Url
                ic.ImageRectOffset = customIcon.ImageRectOffset
                ic.ImageRectSize = customIcon.ImageRectSize
            end
        end
    end

    Window.SetCloseButtonVisible = function(_, visible)
        if floatingCloseBtn and floatingCloseBtn.Button then
            floatingCloseBtn.Button.Visible = (visible == true)
        end
    end

    Window.SetToggleButtonVisible = function(_, visible)
        if floatingToggleBtn and floatingToggleBtn.Button then
            floatingToggleBtn.Button.Visible = (visible == true)
        end
    end

    if not Library.IsMobile then
        if windowInfo.ShowToggleButton ~= false and windowInfo.EnableToggleButton ~= false then
            floatingToggleBtn = Library:AddDraggableImageButton({
                Icon = toggleIconAsset,
                IconSize = 24,
                Func = function()
                    Library:Toggle()
                end,
            })
            floatingToggleBtn.Button.AnchorPoint = Vector2.new(0, 0)
            floatingToggleBtn.Button.Position = togglePos
            styleToggleButton(floatingToggleBtn.Button)
        end

        if showCloseBtn then
            floatingCloseBtn = Library:AddDraggableButton({
                Text = closeBtnText,
                Func = function()
                    local function executeClose()
                        if type(windowInfo.OnClose) == "function" then
                            pcall(windowInfo.OnClose)
                        end
                        Library.ScreenGui:Destroy()
                    end

                    if Window and type(Window.AddDialog) == "function" then
                        Window:AddDialog("ExitScriptConfirm", {
                            Title = closeDialogTitle,
                            Description = closeDialogDesc,
                            Icon = "alert-triangle",
                            AutoDismiss = true,
                            OutsideClickDismiss = true,
                            FooterButtons = {
                                Cancel = { Title = "Cancel", Variant = "Ghost", Order = 1 },
                                Confirm = {
                                    Title = "Yes, Exit",
                                    Variant = "Primary",
                                    Order = 2,
                                    Callback = executeClose,
                                },
                            },
                        })
                    else
                        executeClose()
                    end
                end,
            })
            floatingCloseBtn.Button.AnchorPoint = Vector2.new(0, 0)
            floatingCloseBtn.Button.Position = closeBtnPos
            local closeText = floatingCloseBtn.Button:FindFirstChildOfClass("TextLabel")
            if closeText then
                closeText.TextColor3 = Color3.fromRGB(255, 75, 75)
            end
        end
    else
        local toggleButton
        for _, child in ipairs(Library.ScreenGui:GetDescendants()) do
            if child:IsA("TextButton") or child:IsA("ImageButton") then
                if child.Text == "Toggle" then
                    toggleButton = child
                elseif child.Text == "Lock" or child.Text == "Unlock" or child.Name == "Lock" or child.Name == "LockButton" then
                    child.Visible = false
                    pcall(function() child:Destroy() end)
                end
            end
        end

        if toggleButton then
            styleToggleButton(toggleButton)
        end
    end
end

local Library = loadModifiedLibrary()

local themeSource = safeHttpGet(THEME_URLS)
themeSource = themeSource:gsub('7c5cff', 'ff70a6')
themeSource = themeSource:gsub('7d55ff', 'ff70a6')
themeSource = themeSource:gsub('125,%s*85,%s*255', '255, 112, 166')
local ThemeManager = assert(loadstring(themeSource), "XUAN ThemeManager loadstring failed")()

local saveSource = safeHttpGet(SAVE_URLS)
local SaveManager = assert(loadstring(saveSource), "XUAN SaveManager loadstring failed")()

-- Set Default Theme to Soft Girl Pink
local PINK_SCHEME = {
    FontColor = "ffffff",
    MainColor = "181517",
    AccentColor = "ff70a6",
    BackgroundColor = "0f0d0e",
    OutlineColor = "30242a",
    BackgroundImage = "",
}

if ThemeManager and ThemeManager.BuiltInThemes then
    ThemeManager.BuiltInThemes["Soft Girl Pink"] = { 1, PINK_SCHEME }
    ThemeManager.BuiltInThemes["Default"] = { 1, PINK_SCHEME }
    ThemeManager.DefaultThemeName = "Soft Girl Pink"
end

if Library and Library.Scheme then
    Library.Scheme.AccentColor = Color3.fromHex("ff70a6")
    Library.Scheme.MainColor = Color3.fromHex("181517")
    Library.Scheme.BackgroundColor = Color3.fromHex("0f0d0e")
    Library.Scheme.OutlineColor = Color3.fromHex("30242a")
    Library.Scheme.FontColor = Color3.fromHex("ffffff")
end

local nativeCreateWindow = Library.CreateWindow
Library.CreateWindow = function(self, windowInfo)
    windowInfo = windowInfo or {}
    if not windowInfo.Footer or windowInfo.Footer == "Made By XUAN4SHO" then
        windowInfo.Footer = "Made By XUAN SOFT GIRL"
    end
    if Library.Scheme then
        Library.Scheme.AccentColor = Color3.fromHex("ff70a6")
        Library.Scheme.MainColor = Color3.fromHex("181517")
        Library.Scheme.BackgroundColor = Color3.fromHex("0f0d0e")
        Library.Scheme.OutlineColor = Color3.fromHex("30242a")
        Library.Scheme.FontColor = Color3.fromHex("ffffff")
    end
    local Window = nativeCreateWindow(self, windowInfo)
    applyXuanWindowStyle(self, Window, windowInfo)
    if ThemeManager and type(ThemeManager.ApplyTheme) == "function" then
        pcall(function() ThemeManager:ApplyTheme("Soft Girl Pink") end)
    end
    return Window
end

return Library, ThemeManager, SaveManager
